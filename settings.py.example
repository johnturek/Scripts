# Catalyst Center API Configuration
# Copy this file to settings.py and update with your credentials

# Required: Authentication credentials
CATALYST_USERNAME = "your_username_here"
CATALYST_PASSWORD = "your_password_here"
CATALYST_BASE_URL = "https://your-catalyst-center.example.com"

# Optional: SSL verification (default: True)
# Set to False if using self-signed certificates (not recommended for production)
CATALYST_VERIFY = True

# Optional: API version (default: uses latest)
# CATALYST_VERSION = "2.3.5.3"

# Optional: Request timeout in seconds (default: 60)
# CATALYST_TIMEOUT = 60

# Optional: Enable debug mode (default: False)
# CATALYST_DEBUG = False
